# ==============================================================================
# FitTrack API — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server locally or configure these
# environment variables in your hosting provider (Render, Railway, Fly.io, etc.).
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server Port (Render / hosting platforms assign this dynamically in production)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
# In production, strict security validations (JWT secret length, strict CORS) are enforced.
NODE_ENV=development

# MongoDB Connection String (Atlas Cluster or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fittrack?retryWrites=true&w=majority

# JWT Signing Secret (MUST be at least 32 characters long in production)
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=fittrack-secure-jwt-secret-replace-with-at-least-32-chars-key

# JWT Token Expiration (e.g., '7d', '24h')
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In development: http://localhost:5173,http://localhost:4173
# In production: https://your-frontend-domain.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:4173

# HttpOnly Cookie SameSite Attribute
# Options: 'lax' | 'none' | 'strict'
# IMPORTANT FOR CROSS-DOMAIN DEPLOYMENT:
# When frontend is on Vercel (*.vercel.app) and backend is on Render (*.onrender.com),
# set COOKIE_SAME_SITE=none (paired with Secure=true) to permit cross-site cookie transmission.
# For same-domain or local development, use 'lax'.
COOKIE_SAME_SITE=lax

# Live Demo Overview Mode ('true' | 'false')
# When true, enables the read-only guest demo overview mode for portfolio reviewers.
DEMO_MODE=true
